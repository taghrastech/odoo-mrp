<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_form_view_fixed_qty" model="ir.ui.view">
        <field name="name">mrp.bom.form.fixed.quantity</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='manual_consumption']" position="after">
                <field name="tt_qty_type" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_line_view_form_fixed_qty" model="ir.ui.view">
        <field name="name">mrp.bom.line.form.fixed.quantity</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='possible_bom_product_template_attribute_value_ids']" position="before">
                <field name="tt_qty_type"/>
            </xpath>
        </field>
    </record>

</odoo>
